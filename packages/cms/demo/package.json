{
  "name": "discontent-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:test": "CONTENT_DIRECTORY=test-content next dev --port ${PLAYWRIGHT_PORT:-3011}",
    "build": "next build --webpack",
    "start": "next start --port 3001",
    "start:test": "CONTENT_DIRECTORY=test-content next start --port ${PLAYWRIGHT_PORT:-3011}",
    "lint": "next lint",
    "e2e-dev": "playwright test --project=e2e",
    "e2e-dev:headed": "playwright test --project=e2e --ui",
    "e2e-start": "PLAYWRIGHT_BUILD=1 playwright test --project=e2e",
    "e2e-start:headed": "PLAYWRIGHT_BUILD=1 playwright test --project=e2e --ui",
    "generate-fixtures": "playwright test --project=generators"
  },
  "dependencies": {
    "@discontent/cms": "^1.0.0",
    "fs-extra": "^11.4.1",
    "lmdb": "^3.5.7",
    "next": "16.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "simple-git": "^3.36.0",
    "typescript": "^5.9.3"
  }
}
