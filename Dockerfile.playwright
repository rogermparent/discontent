# Must track the @playwright/test version in the workspace — Playwright refuses
# to run against a mismatched browser bundle, so a stale pin silently fails
# every visual test in the container.
#
# Four pins had drifted apart: this image (1.59.1-noble), the GitHub Actions
# container (1.50.0-jammy), recipe's devDependency (^1.50.0) and portfolio's
# (^1.59.1). All four are 1.59.1 now.
FROM mcr.microsoft.com/playwright:v1.59.1-noble

WORKDIR /app

RUN git config --global user.name "Playwright Tester" \
  && git config --global user.email "playwright@example.com" \
  # `init.defaultBranch` is not cosmetic here. `git-test-content/test-git.bundle`
  # contains only `refs/heads/main`, so cloning it resolves remote HEAD through
  # this setting; without it git 2.43 picks `master`, finds no such ref, and
  # checks out *nothing* — "warning: remote HEAD refers to nonexistent ref".
  # The content directory then has no recipes and ten git.spec tests fail on an
  # empty page. It passes on a developer's machine only because their global
  # config already says `main`.
  && git config --global init.defaultBranch main

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
# The corepack bundled with this image's Node predates npm's signing-key
# rotation, so `corepack enable` dies with "Cannot find matching keyid" before
# it can fetch pnpm — which broke the image build outright. Installing current
# corepack first ships the new keys.
RUN npm install -g corepack@latest && corepack enable

COPY package.json /app/package.json
COPY pnpm-workspace.yaml /app/pnpm-workspace.yaml
COPY pnpm-lock.yaml /app/pnpm-lock.yaml
# Without .npmrc the install runs without `shamefully-hoist=true`, so every
# transitive dependency the apps import but do not declare — lucide-react being
# the first one Next hits — fails to resolve and the dev server never starts.
COPY .npmrc /app/.npmrc
COPY packages/cms/package.json /app/packages/cms/package.json
# The demo is a workspace member like any other. It was the one manifest missing
# from this block, which `--frozen-lockfile` would eventually have caught as a
# lockfile mismatch.
COPY packages/cms/demo/package.json /app/packages/cms/demo/package.json
COPY packages/menus-collection/package.json /app/packages/menus-collection/package.json
COPY packages/pages-collection/package.json /app/packages/pages-collection/package.json
COPY packages/component-library/package.json /app/packages/component-library/package.json
COPY packages/next-static-image/package.json /app/packages/next-static-image/package.json
COPY packages/projects-collection/package.json /app/packages/projects-collection/package.json
COPY websites/recipe-website/common/package.json /app/websites/recipe-website/common/package.json
COPY websites/recipe-website/editor/package.json /app/websites/recipe-website/editor/package.json
COPY websites/recipe-website/export/package.json /app/websites/recipe-website/export/package.json
# Portfolio's three manifests. Omitting them would make `--frozen-lockfile`
# mismatch the moment portfolio stopped being .dockerignore'd — the lockfile
# describes workspace members the image would not have.
COPY websites/portfolio/common/package.json /app/websites/portfolio/common/package.json
COPY websites/portfolio/editor/package.json /app/websites/portfolio/editor/package.json
COPY websites/portfolio/export/package.json /app/websites/portfolio/export/package.json

RUN pnpm install --frozen-lockfile

COPY . .

# Which site's suite to run. The WORKDIR and CMD were hardcoded to the recipe
# editor, so one image could only ever test one of the two sites.
ENV SITE_DIR=websites/recipe-website/editor

ENV CI=true
ENV SHARD_INDEX=1
ENV SHARD_TOTAL=1
ENV PLAYWRIGHT_ARGS=""

# Which Playwright projects to run. Parameterized rather than baked into the
# CMD because the three suites disagree: recipe and portfolio define `e2e` and
# `mobile`, the cms demo defines only `e2e` — and `--project=mobile` against a
# config with no such project is a hard error, not a no-op, so the demo could
# not use this image at all. Recipe and portfolio keep the old value as the
# default, so their invocations are byte-identical.
#
# It must stay a *pinned list* rather than being allowed to default to "every
# project": all three suites also define a `generators` project that rewrites
# its own fixtures in place, and an unpinned run would silently regenerate
# them. The pin is a correctness guard, not a filter.
ENV PLAYWRIGHT_PROJECTS="--project=e2e --project=mobile"

# `cd` in the CMD rather than a build-time WORKDIR, so one image serves every
# site and the choice stays a runtime variable.
#
# `${PLAYWRIGHT_PROJECTS}` is deliberately unquoted: `sh -c` must word-split it
# into two arguments for the recipe/portfolio default. Quoting it passes one
# bogus argument and Playwright exits with "no tests found".
CMD ["sh", "-c", "cd /app/${SITE_DIR} && pnpm exec playwright test ${PLAYWRIGHT_PROJECTS} --shard=${SHARD_INDEX}/${SHARD_TOTAL} --reporter=blob --output=test-results ${PLAYWRIGHT_ARGS}"]
