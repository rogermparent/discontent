# The editor's curator agent (epic 44): web search for a local model.
#
# RECIPE_SEARCH_URL is a SearXNG instance's base URL; the agent's
# `web_search` tool calls `<url>/search?q=…&format=json`. Unset, a local
# model gets no web search (it works from the URLs you give it); with the
# Claude API (RECIPE_LLM_API=anthropic) Anthropic's own search is used and
# this is not needed.
#
# Run SearXNG on the workstation (https://docs.searxng.org/admin/installation-docker.html):
#
#   mkdir -p ~/searxng/config ~/searxng/data && cd ~/searxng
#   docker run --name searxng -d --restart unless-stopped \
#     -p 127.0.0.1:8888:8080 \
#     -v "./config/:/etc/searxng/" -v "./data/:/var/cache/searxng/" \
#     docker.io/searxng/searxng:latest
#
# Then enable JSON output in ~/searxng/config/settings.yml (written on the
# first start) and `docker restart searxng` — without it every search is a 403
# (https://docs.searxng.org/admin/settings/settings_search.html):
#
#   search:
#     formats:
#       - html
#       - json
#
# Also raise the engines' timeout in the same file: the default 3 s timed out
# every engine on the workstation (all "timeout", then suspended); 10 s gave
# ~23 results in ~10 s:
#
#   outgoing:
#     request_timeout: 10.0
#     max_request_timeout: 15.0
#
# The container takes ownership of ~/searxng/config, so edit settings.yml with
# `docker exec searxng sh -c '…'` or sudo, then `docker restart searxng`.
# Check: curl 'http://127.0.0.1:8888/search?q=cookies&format=json'
#
# RECIPE_SEARCH_URL=http://127.0.0.1:8888

# The curator's own local model (epic 51, 51a): `/curator` and `recipes agent`
# run on it while imports keep RECIPE_LLM_MODEL (qwen3.5:9b answered the
# curator's asks where qwen3:8b did not). Unset: RECIPE_LLM_MODEL. Not read
# when RECIPE_LLM_API=anthropic. An import the curator starts reads on
# RECIPE_LLM_MODEL, so it loads that model beside the curator's.
#
# RECIPE_AGENT_MODEL=qwen3.5:9b

# The models "Tidy with the model" offers beside RECIPE_LLM_MODEL (epic 50),
# comma or space separated; each must be pulled on RECIPE_LLM_URL's server.
#
# RECIPE_LLM_TIDY_MODELS=qwen3:14b,qwen3.5:9b

# A local model's agent runs (epic 44, 44e). RECIPE_AGENT_NUM_CTX is the
# context every turn of a run asks for, 12288 (default) or 16384 — fixed for
# the run, since changing it reloads the model; 16384 needs more VRAM than
# qwen3:8b leaves free on an 8 GB card. RECIPE_AGENT_THINK=1 lets the model
# think before each answer (slower; default off).
#
# RECIPE_AGENT_NUM_CTX=12288
# RECIPE_AGENT_THINK=0

# A Claude API agent run's cost budget, in dollars (epic 46, 46d): the run
# stops cleanly once its estimated cost reaches it ("Stopped at the cost
# budget ($1.00)"). Default 1, at most 50. A local model has no cap.
#
# RECIPE_AGENT_MAX_COST_USD=1
