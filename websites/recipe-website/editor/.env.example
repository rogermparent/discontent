# The editor's curator agent (epic 44): web search for a local model.
#
# RECIPE_SEARCH_URL is a SearXNG instance's base URL; the agent's
# `web_search` tool calls `<url>/search?q=…&format=json`. Unset, a local
# model gets no web search (it works from the URLs you give it); with the
# Claude API (RECIPE_LLM_API=anthropic) Anthropic's own search is used and
# this is not needed.
#
# Run SearXNG on the workstation (https://docs.searxng.org/admin/installation-docker.html):
#
#   mkdir -p ~/searxng/config ~/searxng/data && cd ~/searxng
#   docker run --name searxng -d --restart unless-stopped \
#     -p 127.0.0.1:8888:8080 \
#     -v "./config/:/etc/searxng/" -v "./data/:/var/cache/searxng/" \
#     docker.io/searxng/searxng:latest
#
# Then enable JSON output in ~/searxng/config/settings.yml (written on the
# first start) and `docker restart searxng` — without it every search is a 403
# (https://docs.searxng.org/admin/settings/settings_search.html):
#
#   search:
#     formats:
#       - html
#       - json
#
# RECIPE_SEARCH_URL=http://127.0.0.1:8888

# A local model's agent runs (epic 44, 44e). RECIPE_AGENT_NUM_CTX is the
# context every turn of a run asks for, 12288 (default) or 16384 — fixed for
# the run, since changing it reloads the model; 16384 needs more VRAM than
# qwen3:8b leaves free on an 8 GB card. RECIPE_AGENT_THINK=1 lets the model
# think before each answer (slower; default off).
#
# RECIPE_AGENT_NUM_CTX=12288
# RECIPE_AGENT_THINK=0
