{
  "name": "recipe-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "TEST_MODE=true next dev --port ${PLAYWRIGHT_PORT:-3019}",
    "start:test": "TEST_MODE=true next start --port ${PLAYWRIGHT_PORT:-3019}",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "create-user": "tsx ./scripts/create-user.ts",
    "create-token": "tsx ./scripts/create-token.ts",
    "revoke-token": "tsx ./scripts/revoke-token.ts",
    "recipes": "tsx ./cli/index.ts",
    "mcp": "tsx ./mcp/server.ts",
    "e2e-dev": "playwright test --project=e2e --project=mobile",
    "e2e-dev:headed": "playwright test --project=e2e --project=mobile --ui",
    "e2e-dev:update": "playwright test --project=e2e --project=mobile --update-snapshots",
    "e2e-dev:mobile": "playwright test --project=mobile",
    "e2e-dev:visual": "playwright test --project=e2e --project=mobile --grep @visual",
    "e2e-dev:update-functional-snaps": "playwright test empty-state.spec featured-recipes.spec recipe.spec ingredient-preview.spec menus.spec yield.spec paste-replace.spec --project=e2e --update-snapshots",
    "e2e-start": "PLAYWRIGHT_BUILD=1 playwright test --project=e2e --project=mobile",
    "e2e-start:headed": "PLAYWRIGHT_BUILD=1 playwright test --project=e2e --project=mobile --ui",
    "e2e-start:update": "PLAYWRIGHT_BUILD=1 playwright test --project=e2e --project=mobile --update-snapshots",
    "e2e-shard": "playwright test --project=e2e --project=mobile --reporter=blob",
    "e2e-merge": "playwright merge-reports --reporter=html,list ./blob-reports/",
    "e2e-codegen": "playwright codegen http://localhost:${PLAYWRIGHT_PORT:-3019}",
    "generate-fixtures": "playwright test --project=generators"
  },
  "dependencies": {
    "@discontent/cms": "^1.0.0",
    "@discontent/component-library": "^1.0.0",
    "@discontent/menus-collection": "^1.0.0",
    "@discontent/next-static-image": "^0.0.1",
    "@discontent/pages-collection": "^1.0.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@sindresorhus/slugify": "^3.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "entities": "^7.0.1",
    "execa": "^9.6.1",
    "flexsearch": "^0.8.212",
    "format-quantity": "^3.2.0",
    "fraction.js": "^5.3.4",
    "fs-extra": "^11.4.1",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-mdast": "^10.1.2",
    "html-entities": "^2.6.0",
    "lmdb": "^3.5.7",
    "lodash": "^4.18.1",
    "markdown-to-jsx": "~9.10.3",
    "mdast-util-to-markdown": "^2.2.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.30",
    "parse5": "^8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read": "^5.0.1",
    "recipe-website-common": "^1.0.0",
    "sharp": "0.35.5",
    "simple-git": "^3.36.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@types/bcrypt": "^6.0.0",
    "@types/eslint-plugin-mocha": "^10.4.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.26",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-mocha": "^11.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.30",
    "prettier": "3.9.10",
    "schema-dts": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
