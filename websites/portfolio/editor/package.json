{
  "name": "portfolio-website-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "TEST_MODE=true next dev --port ${PLAYWRIGHT_PORT:-3029}",
    "start:test": "TEST_MODE=true next start --port ${PLAYWRIGHT_PORT:-3029}",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "create-user": "node ./scripts/create-user.mjs",
    "seed": "tsx ./scripts/seed-projects.ts ./content && tsx ./scripts/seed-pages.ts ./content",
    "e2e-dev": "playwright test --project=e2e --project=mobile",
    "e2e-dev:headed": "playwright test --project=e2e --project=mobile --ui",
    "e2e-dev:update": "playwright test --project=e2e --project=mobile --update-snapshots",
    "e2e-dev:mobile": "playwright test --project=mobile",
    "e2e-start": "PLAYWRIGHT_BUILD=1 playwright test --project=e2e --project=mobile",
    "e2e-codegen": "playwright codegen http://localhost:${PLAYWRIGHT_PORT:-3029}"
  },
  "dependencies": {
    "@discontent/cms": "^1.0.0",
    "@discontent/component-library": "^1.0.0",
    "@discontent/menus-collection": "^1.0.0",
    "@discontent/next-static-image": "^0.0.1",
    "@discontent/pages-collection": "^1.0.0",
    "@discontent/projects-collection": "^1.0.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@tanstack/react-query": "^5.104.3",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "entities": "^7.0.1",
    "execa": "^9.6.1",
    "flexsearch": "^0.8.212",
    "format-quantity": "^3.2.0",
    "fraction.js": "^5.3.4",
    "fs-extra": "^11.4.1",
    "lmdb": "^3.5.7",
    "lodash": "^4.18.1",
    "markdown-to-jsx": "~9.6.1",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.30",
    "portfolio-website-common": "^1.0.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.34.5",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.59.1",
    "@types/bcrypt": "^6.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.26",
    "@types/node": "^25.9.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "^11.3.3",
    "postcss": "^8.5.30",
    "prettier": "3.8.5",
    "read": "^5.0.1",
    "simple-git": "~3.33.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{json,md,mdx,yml,yaml,css}": "prettier --write",
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
