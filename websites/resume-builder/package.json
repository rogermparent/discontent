{
  "name": "resume-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "start": "next start",
    "start:test": "TEST_MODE=true next start --port 3010",
    "dev": "next dev",
    "dev:test": "TEST_MODE=true next dev --port 3010",
    "lint": "next lint",
    "e2e-dev": "playwright test --project=e2e",
