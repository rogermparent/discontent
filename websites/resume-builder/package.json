    "fs-extra": "^11.3.3",
    "lmdb": "^3.5.1",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.6",
    "simple-git": "^3.30.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
