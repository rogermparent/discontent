#!/bin/sh
# post-receive for the Pi's content repository (~/recipes/.git/hooks/).
# Installed by `pnpm deploy:pi --setup`; the copy in the repo
# (deploy/pi/post-receive) is the one to edit.
#
# A push moves the working tree (receive.denyCurrentBranch updateInstead) but
# not the editor's indexes. This asks the running editor to rebuild them, in
# the background so the push returns at once — a full rebuild takes minutes on
# the Pi's SD card.
#
# `git push -o no-reindex …` skips it, for when the workstation is about to
# ship indexes it built itself (`pnpm deploy:pi --sync-index`).

token_file="$HOME/recipe-editor/hook.env"
url="${RECIPE_EDITOR_URL:-http://localhost:3000}"

i=0
while [ "$i" -lt "${GIT_PUSH_OPTION_COUNT:-0}" ]; do
  eval "option=\${GIT_PUSH_OPTION_$i}"
  if [ "$option" = "no-reindex" ]; then
    echo "post-receive: no-reindex; indexes left as they are"
    exit 0
  fi
  i=$((i + 1))
done

current=$(git symbolic-ref -q HEAD || true)
moved=
while read -r old new ref; do
  [ "$ref" = "$current" ] && moved=1
done
[ -n "$moved" ] || exit 0

if [ ! -r "$token_file" ]; then
  echo "post-receive: no $token_file; use Rebuild indexes in the editor" >&2
  exit 0
fi

# The token is read inside the background job and handed to curl on stdin
# (`-H @-`), so it never appears in a process listing.
nohup sh -c '
  sed -n "s/^RECIPE_REINDEX_TOKEN=/Authorization: Bearer /p" "$2" \
  | curl -fsS --max-time 1800 -X POST "$1/api/reindex" -H @- \
      -H "Content-Type: application/json" -d "{}" >/dev/null \
  || echo "$(date -Is) reindex request failed" >&2
' post-receive-reindex "$url" "$token_file" \
  >/dev/null 2>>"$HOME/recipe-editor/hook.log" &

echo "post-receive: the editor is rebuilding its indexes in the background"
